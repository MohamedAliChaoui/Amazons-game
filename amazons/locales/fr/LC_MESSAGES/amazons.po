msgid "Unknown show command. Use: board, history, time, configuration"
msgstr "Commande inconnue. Utilisez : board, history, time, configuration"

msgid "Error: size must be between 4 and 11"
msgstr "Erreur : la taille doit être comprise entre 4 et 11"

msgid "Only the host can load a saved game in network mode."
msgstr "Seul l'hôte peut charger une partie sauvegardée en mode réseau."

msgid ""
"Commands:\n"
"            new | n [hu|ai|aiai|network]  Start a new game\n"
"            new PLAYER_ID                Invite an idle player to a new game\n"
"            show board | sb              Display the board\n"
"            show history                 Display move history\n"
"            history | hist               Show move history\n"
"            show time                    Display remaining time\n"
"            show configuration           Display current settings\n"
"            server list                  Discover servers on LAN\n"
"            server start [port]          Start the local server\n"
"            server stop                  Stop the local server\n"
"            server status                Show server port, clients and games\n"
"            players [PLAYER_ID]          Show connected players or one profile\n"
"            scoreboard                   Show player wins, losses and games\n"
"            join <host[:port]>           Connect to a remote server\n"
"            ping                         Ping the connected server\n"
"            status                       Show network status\n"
"            move <from>-<to>             Start a move; arrow is prompted\n"
"                                         separately\n"
"            choice <square>              Show legal moves from a square\n"
"            undo [N]                     Undo the last round; with N, repeat\n"
"                                         undo up to N times (consent is asked\n"
"                                         each time in human-vs-human)\n"
"            redo [N]                     Redo the last undone round; with N,\n"
"                                         repeat redo up to N times (may stop\n"
"                                         early if the next redo is not yours)\n"
"            accept                       Accept the current invitation\n"
"            decline                      Decline the current invitation\n"
"            cancel                       Cancel the pending invitation\n"
"            help | h                     Show help\n"
"            quit | q                     Exit\n"
"\n"
"            Startup options:\n"
"                python -m amazons -h\n"
"                -n, --size\n"
"                -t, --time\n"
"                -g, --gui\n"
"                --ai-time\n"
"                --ai-mode\n"
"                --ai-minimax-scoring\n"
"                --ai-minimax-depth\n"
"            "

msgstr ""
"Commandes :\n"
"            new | n [hu|ai|aiai|network]  Démarrer une nouvelle partie\n"
"            new PLAYER_ID                Inviter un joueur disponible à une nouvelle partie\n"
"            show board | sb              Afficher le plateau\n"
"            show history                 Afficher l'historique\n"
"            history | hist               Afficher l'historique des coups\n"
"            show time                    Afficher le temps restant\n"
"            show configuration           Afficher la configuration active\n"
"            server list                  Rechercher les serveurs sur le LAN\n"
"            server start [port]          Démarrer le serveur local\n"
"            server stop                  Arrêter le serveur local\n"
"            server status                Afficher le port, les clients et les parties en cours\n"
"            players [PLAYER_ID]          Afficher les joueurs connectés ou un profil détaillé\n"
"            scoreboard                   Afficher victoires, défaites et parties jouées\n"
"            join <host[:port]>           Se connecter à un serveur distant\n"
"            ping                         Tester la connexion au serveur\n"
"            status                       Afficher l'état du réseau\n"
"            move <from>-<to>             Démarrer un coup ; la flèche est\n"
"                                         demandée séparément\n"
"            choice <square>              Afficher les coups légaux depuis une case\n"
"            undo [N]                     Annuler le dernier tour ; avec N, répéter\n"
"                                         l'annulation jusqu'à N fois (avec accord\n"
"                                         à chaque fois en humain contre humain)\n"
"            redo [N]                     Refaire le dernier tour annulé ; avec N,\n"
"                                         répète jusqu'à N fois (peut s'arrêter\n"
"                                         avant si le prochain redo n'est pas le vôtre)\n"
"            accept                       Accepter l'invitation en cours\n"
"            decline                      Refuser l'invitation en cours\n"
"            cancel                       Annuler l'invitation en attente\n"
"            help | h                     Afficher l'aide\n"
"            quit | q                     Quitter\n"
"\n"
"            Options de démarrage :\n"
"                python -m amazons -h\n"
"                -n, --size\n"
"                -t, --time\n"
"                -g, --gui\n"
"                --ai-time\n"
"                --ai-mode\n"
"                --ai-minimax-scoring\n"
"                --ai-minimax-depth\n"
"            "

